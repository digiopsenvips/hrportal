# =========================================================================
# ENACTUS VIPS-TC MANAGEMENT & HR PORTAL — ENVIRONMENT CONFIGURATION
# =========================================================================

# Node Environment & Server Port (Render / Local)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# -------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE & AUTH CONFIGURATION
# -------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key-here
# Optional Direct PostgreSQL Connection String for database migrations:
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# -------------------------------------------------------------------------
# 2. SESSION & SECURITY SECRETS
# -------------------------------------------------------------------------
# Strong random secret used for session tokens and encryption
SESSION_SECRET=enactus-vips-tc-production-secret-key-2026-replace-in-prod
NEXTAUTH_SECRET=enactus-vips-tc-production-secret-key-2026-replace-in-prod
NEXTAUTH_URL=http://localhost:3000

# -------------------------------------------------------------------------
# 3. PRODUCTION HOSTING URLS (Vercel Frontend & Render Backend)
# -------------------------------------------------------------------------
# On Vercel: The public domain where your frontend is deployed
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Render / Standalone Backend: Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://enactus-vips-portal.vercel.app

# -------------------------------------------------------------------------
# 4. OPTIONAL EXTERNAL INTEGRATIONS (Google OAuth & Notifications)
# -------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# SMTP Email Notifications (optional):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=operations@enactusvips.org
# SMTP_PASS=your-app-password
